{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Información del perfil del usuario y configuración financiera.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "ID único del usuario de Firebase Auth." },
        "displayName": { "type": "string", "description": "Nombre visible del usuario." },
        "email": { "type": "string", "description": "Correo electrónico del usuario." },
        "monthlyBudget": { "type": "number", "description": "Presupuesto mensual establecido." },
        "autoSaveEnabled": { "type": "boolean", "description": "Si el ahorro automático está activado." },
        "roundUpEnabled": { "type": "boolean", "description": "Si el redondeo de compras está activado." },
        "phone": { "type": "string", "description": "Número de teléfono registrado obligatoriamente." },
        "subscriptionStart": { "type": "string", "description": "Fecha de inicio de la suscripción." },
        "subscriptionEnd": { "type": "string", "description": "Fecha de vencimiento de la suscripción." },
        "subscriptionStatus": { "type": "string", "enum": ["activa", "vencida", "suspendida"], "description": "Estado de la suscripción SaaS." },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "Rol del usuario en el sistema." }
      },
      "required": ["uid", "email", "monthlyBudget"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Un registro de ingreso o gasto.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string", "description": "ID del usuario propietario." },
        "amount": { "type": "number" },
        "category": { "type": "string", "enum": ["Comida", "Transporte", "Ocio", "Vivienda", "Salud", "Suscripciones", "Otros"] },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["expense", "income"] }
      },
      "required": ["uid", "amount", "category", "description", "date", "type"]
    },
    "SavingGoal": {
      "title": "SavingGoal",
      "description": "Una meta de ahorro del usuario.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "icon": { "type": "string" },
        "deadline": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "targetAmount", "currentAmount"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Un activo físico o mueble/inmueble registrado en el inventario del usuario.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Inmuebles", "Vehículos", "Tecnología", "Equipamiento", "Otros"] },
        "value": { "type": "number" },
        "purchaseDate": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["uid", "name", "category", "value", "purchaseDate"]
    },
    "DailySalesSummary": {
      "title": "DailySalesSummary",
      "description": "El total de ventas diarias archivado de cada jornada cerrada.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" },
        "totalUnitsSold": { "type": "number" },
        "totalIncome": { "type": "number" },
        "totalProfit": { "type": "number" },
        "productsSold": { "type": "array" }
      },
      "required": ["uid", "date", "createdAt", "totalUnitsSold", "totalIncome", "totalProfit", "productsSold"]
    },
    "RegisteredPhone": {
      "title": "RegisteredPhone",
      "description": "Log de números de teléfono registrados para prevención de fraude y limitar una cuenta por teléfono.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "ID del usuario propietario del número de teléfono." },
        "email": { "type": "string", "description": "Email registrado." }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Documento de perfil de usuario."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Colección de transacciones del usuario."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "SavingGoal",
      "description": "Colección de metas de ahorro del usuario."
    },
    "/users/{userId}/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Colección de activos e inventario del usuario."
    },
    "/users/{userId}/daily_summaries/{summaryId}": {
      "schema": "DailySalesSummary",
      "description": "Lista de cierres diarios e historial de ventas guardadas."
    },
    "/registered_phones/{phone}": {
      "schema": "RegisteredPhone",
      "description": "Colección global de teléfonos registrados para prevenir múltiples cuentas."
    }
  }
}
